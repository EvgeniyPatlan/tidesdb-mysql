+    /* TidesDB engine sync_mode enum (from tidesdb.h):
+     *   TDB_SYNC_NONE     = 0
+     *   TDB_SYNC_INTERVAL = 1   (periodic background flush)
+     *   TDB_SYNC_FULL     = 2   (fsync/O_DSYNC on every write)
+     *
+     * Block manager only has two modes (NONE/FULL); INTERVAL maps to NONE
+     * at the block-manager level (the engine's periodic flusher takes
+     * care of syncing). Previously case 1 returned FULL and case 2 fell
+     * through to default->NONE -- exactly upside-down, so requesting FULL
+     * silently got NONE and the per-block fdatasync was skipped on the
+     * WAL, breaking durability on SIGKILL/power-loss. */
     switch (tdb_sync_mode)
     {
-        case 0:
+        case 0:           /* TDB_SYNC_NONE */
             return BLOCK_MANAGER_SYNC_NONE;
-        case 1:
+        case 1:           /* TDB_SYNC_INTERVAL: handled by engine flusher */
+            return BLOCK_MANAGER_SYNC_NONE;
+        case 2:           /* TDB_SYNC_FULL */
             return BLOCK_MANAGER_SYNC_FULL;
         default:
             return BLOCK_MANAGER_SYNC_NONE;
