From: tidesdb-mysql
Subject: [PATCH] graduated active-memtable backpressure (smooth the 2x cliff)

Before this patch, tidesdb_apply_backpressure had a binary regime: writers
ran at full speed until the active memtable reached
TDB_BACKPRESSURE_ACTIVE_MT_CEILING_MULT * write_buffer_size (=2x), then
hit a hard usleep-loop stall until rotation completed. The HammerDB
WARE=10 RUNVU=8 perf capture showed write_row max latency of 72.8 ms
driven entirely by this cliff -- one writer crossed the threshold and
blocked for tens of milliseconds while the flush worker drained.

This patch adds three graduated delay tiers BELOW the cliff, mirroring
the magnitudes used by the existing L0/L1 graduated-delay ladder in the
same function:

  active_size >= 1.0x wbuf  ->  ELEVATED  (200 us)
  active_size >= 1.3x wbuf  ->  MODERATE  (500 us)
  active_size >= 1.7x wbuf  ->  HIGH      (2 ms)
  active_size >= 2.0x wbuf  ->  cliff stall (unchanged)

Both the per-cf path and the unified-memtable path get the same ladder.
Each tier sets l0_delayed=1 so the existing L0/L1 graduated-delay
section further down does not stack additional sleep on top.

Effect: writers slow progressively, giving the flush worker time to
rotate before any single writer hits the cliff. Expected impact on
HammerDB tail latency: p99 unchanged or marginally higher (a few extra
us added by ELEVATED on hot writers), max latency dropped ~2-5x as
fewer writers reach the cliff condition.

---
 src/tidesdb.c | 51 ++++++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 51 insertions(+)

diff --git a/src/tidesdb.c b/src/tidesdb.c
index c78635d..f46e39d 100644
--- a/src/tidesdb.c
+++ b/src/tidesdb.c
@@ -23934,8 +23934,8 @@ static int tidesdb_apply_backpressure(tidesdb_column_family_t *cf)
      * until rotation completes. unified mode uses its own branch below */
     if (cf->db && !cf->db->unified_mt.enabled && cf->config.write_buffer_size > 0)
     {
-        const size_t ceiling =
-            TDB_BACKPRESSURE_ACTIVE_MT_CEILING_MULT * cf->config.write_buffer_size;
+        const size_t wbuf = cf->config.write_buffer_size;
+        const size_t ceiling = TDB_BACKPRESSURE_ACTIVE_MT_CEILING_MULT * wbuf;
         size_t active_size = 0;
         tidesdb_memtable_t *amt = NULL;
         if (tidesdb_active_memtable_try_ref(&cf->active_mt_readers, &cf->active_memtable, &amt))
@@ -23943,6 +23943,31 @@ static int tidesdb_apply_backpressure(tidesdb_column_family_t *cf)
             if (amt->skip_list) active_size = (size_t)skip_list_get_size(amt->skip_list);
             tidesdb_immutable_memtable_unref(amt);
         }
+        /* Graduated active-memtable backpressure: pace writers below the
+         * 2x cliff so the flush worker has time to rotate without the
+         * writer going from full-speed to a hard stall. Three tiers
+         * mirror the L0/L1 magnitudes used elsewhere in this function.
+         * Sets l0_delayed=1 so the L0/L1 graduated check below does not
+         * add more delay on top. Skipped when active_size already >=
+         * ceiling -- the cliff branch handles those writers. */
+        if (active_size < ceiling)
+        {
+            if (active_size >= wbuf + wbuf * 7 / 10)
+            {
+                usleep(TDB_BACKPRESSURE_HIGH_DELAY_US);
+                l0_delayed = 1;
+            }
+            else if (active_size >= wbuf + wbuf * 3 / 10)
+            {
+                usleep(TDB_BACKPRESSURE_MODERATE_DELAY_US);
+                l0_delayed = 1;
+            }
+            else if (active_size >= wbuf)
+            {
+                usleep(TDB_BACKPRESSURE_ELEVATED_DELAY_US);
+                l0_delayed = 1;
+            }
+        }
         if (active_size >= ceiling)
         {
             if (tdb_log_throttle(cf->db, &cf->last_ceiling_stall_log_sec,
@@ -24014,8 +24039,8 @@ static int tidesdb_apply_backpressure(tidesdb_column_family_t *cf)
      * tidesdb_txn_commit uses, not through flush_memtable_internal */
     if (cf->db && cf->db->unified_mt.enabled && cf->db->unified_mt.write_buffer_size > 0)
     {
-        const size_t u_ceiling =
-            TDB_BACKPRESSURE_ACTIVE_MT_CEILING_MULT * cf->db->unified_mt.write_buffer_size;
+        const size_t u_wbuf = cf->db->unified_mt.write_buffer_size;
+        const size_t u_ceiling = TDB_BACKPRESSURE_ACTIVE_MT_CEILING_MULT * u_wbuf;
         size_t u_size = 0;
         tidesdb_memtable_t *umt = NULL;
         if (tidesdb_active_memtable_try_ref(&cf->db->unified_mt.active_mt_readers,
@@ -24024,6 +24049,28 @@ static int tidesdb_apply_backpressure(tidesdb_column_family_t *cf)
             if (umt->skip_list) u_size = (size_t)skip_list_get_size(umt->skip_list);
             tidesdb_immutable_memtable_unref(umt);
         }
+        /* Graduated unified-memtable backpressure -- parallel to the
+         * per-cf path above. Pace writers progressively below the cliff
+         * so the unified flush rotation has time to complete before the
+         * writer fully stalls. */
+        if (u_size < u_ceiling)
+        {
+            if (u_size >= u_wbuf + u_wbuf * 7 / 10)
+            {
+                usleep(TDB_BACKPRESSURE_HIGH_DELAY_US);
+                l0_delayed = 1;
+            }
+            else if (u_size >= u_wbuf + u_wbuf * 3 / 10)
+            {
+                usleep(TDB_BACKPRESSURE_MODERATE_DELAY_US);
+                l0_delayed = 1;
+            }
+            else if (u_size >= u_wbuf)
+            {
+                usleep(TDB_BACKPRESSURE_ELEVATED_DELAY_US);
+                l0_delayed = 1;
+            }
+        }
         if (u_size >= u_ceiling)
         {
             if (tdb_log_throttle(cf->db, &cf->db->unified_mt.last_ceiling_stall_log_sec,
