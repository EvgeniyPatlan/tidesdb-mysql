END|
#
# ============================================
# TEST 4: Conflict storm -- all 4 connections hit same rows
#   Maximizes TDB_ERR_CONFLICT / ERROR 1180 rate.
#   Exercises the failed-commit -> txn_free -> new txn_begin path.
# ============================================
#
DROP PROCEDURE IF EXISTS p_storm|
Warnings:
Note	1305	PROCEDURE test.p_storm does not exist
CREATE PROCEDURE p_storm(IN base_k INT)
BEGIN
DECLARE CONTINUE HANDLER FOR 1180, 1213, 1205 BEGIN END;
SET @i = 1;
WHILE @i <= 500 DO
START TRANSACTION;
UPDATE sbtest1 SET k = @i + base_k WHERE id = 1;
UPDATE sbtest1 SET k = @i + base_k WHERE id = 2;
UPDATE sbtest1 SET k = @i + base_k WHERE id = 3;
COMMIT;
SET @i = @i + 1;
END WHILE;
END|
SELECT COUNT(*) FROM sbtest1 WHERE id IN (1, 2, 3);
Conflict storm: OK
#
# === Cleanup ===
#
DROP PROCEDURE p_wr1;
DROP PROCEDURE p_wr2;
DROP PROCEDURE p_wr3;
DROP PROCEDURE p_wr4;
DROP PROCEDURE p_loop_upd1_plus;
DROP PROCEDURE p_loop_upd1_minus;
DROP PROCEDURE p_loop_ins1;
DROP PROCEDURE p_loop_ins2;
DROP PROCEDURE p_storm;
DROP TABLE sbtest1;
DROP TABLE sbtest2;
# Done.
