#
# === Verify data integrity after concurrent writes ===
#
PK/index consistency: OK
#
# ============================================
# TEST 3: Rapid txn churn (commit + immediate new txn)
#   1000 tiny autocommit writes per connection x 4 connections
#   Tests rapid txn_begin/txn_free cycling without BEGIN/COMMIT
# ============================================
#
DROP PROCEDURE IF EXISTS p_loop_upd1_plus|
Warnings:
Note	1305	PROCEDURE test.p_loop_upd1_plus does not exist
CREATE PROCEDURE p_loop_upd1_plus()
BEGIN
SET @i = 1;
WHILE @i <= 1000 DO
UPDATE sbtest1 SET k = k + 1 WHERE id = 1 + (@i % 5000);
SET @i = @i + 1;
END WHILE;
END|
DROP PROCEDURE IF EXISTS p_loop_upd1_minus|
Warnings:
Note	1305	PROCEDURE test.p_loop_upd1_minus does not exist
CREATE PROCEDURE p_loop_upd1_minus()
BEGIN
SET @i = 1;
WHILE @i <= 1000 DO
UPDATE sbtest1 SET k = k - 1 WHERE id = 1 + ((@i + 500) % 5000);
SET @i = @i + 1;
END WHILE;
END|
DROP PROCEDURE IF EXISTS p_loop_ins1|
Warnings:
Note	1305	PROCEDURE test.p_loop_ins1 does not exist
CREATE PROCEDURE p_loop_ins1()
BEGIN
SET @i = 1;
WHILE @i <= 1000 DO
INSERT INTO sbtest1 (k, c, pad) VALUES (FLOOR(RAND()*100000), REPEAT('q',120), REPEAT('r',60));
SET @i = @i + 1;
END WHILE;
END|
