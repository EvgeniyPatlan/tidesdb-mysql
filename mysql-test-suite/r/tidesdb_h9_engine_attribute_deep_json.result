# 1. A reasonably nested but schema-non-matching JSON: parses fine
#    via the iterative path; engine ignores unrecognized keys.
CREATE TABLE t_h9_a (id INT PRIMARY KEY) ENGINE=TidesDB
ENGINE_ATTRIBUTE='{"a":{"b":{"c":{"d":{"e":{"f":{"g":{"h":{"i":{"j":1}}}}}}}}}}';
DROP TABLE t_h9_a;
# 2. Malformed JSON is rejected by MySQL's own validation
#    BEFORE reaching the engine -- not specifically the H-9 fix
#    but confirms the surface around it is safe.
CREATE TABLE t_h9_b (id INT PRIMARY KEY) ENGINE=TidesDB
ENGINE_ATTRIBUTE='{not valid json';
ERROR HY000: Invalid json attribute, error: "Missing a name for object member." at pos 1: 'not valid json'
# 3. A valid recognized key still parses and applies, proving the
#    iterative parser hasn't broken the happy path.
CREATE TABLE t_h9_c (id INT PRIMARY KEY) ENGINE=TidesDB
ENGINE_ATTRIBUTE='{"compression":"LZ4"}';
SHOW CREATE TABLE t_h9_c;
Table	Create Table
t_h9_c	CREATE TABLE `t_h9_c` (
  `id` int NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=TIDESDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci /*!80021 ENGINE_ATTRIBUTE='{"compression": "LZ4"}' */
DROP TABLE t_h9_c;
#
# Done.
