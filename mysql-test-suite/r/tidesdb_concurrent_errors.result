DROP PROCEDURE IF EXISTS p_c4|
Warnings:
Note	1305	PROCEDURE test.p_c4 does not exist
CREATE PROCEDURE p_c4()
BEGIN
DECLARE CONTINUE HANDLER FOR 1180, 1213, 1205 BEGIN END;
DECLARE CONTINUE HANDLER FOR 1030 SET @err_1030 = @err_1030 + 1;
SET @i = 1;
SET @err_1030 = 0;
WHILE @i <= 300 DO
UPDATE t1 SET k = k + 1 WHERE id = 1 + (@i % 2000);
SET @i = @i + 1;
END WHILE;
END|
#
# === Verify: no error 1030 (HA_ERR_GENERIC) was produced ===
#
# c1 error_1030 count:
SELECT @err_1030 AS err_1030_c1;
err_1030_c1
0
# c2 error_1030 count:
SELECT @err_1030 AS err_1030_c2;
err_1030_c2
0
# c3 error_1030 count:
SELECT @err_1030 AS err_1030_c3;
err_1030_c3
0
# c4 error_1030 count:
SELECT @err_1030 AS err_1030_c4;
err_1030_c4
0
#
# === Verify data integrity (PK count == index count) ===
#
Data integrity: OK
#
# ============================================
# TEST 2: Conflict storm -- all connections hit SAME 3 rows
#   Maximizes conflict rate. Before fix these would be
#   error 1030; after fix they are error 1213 (retryable).
# ============================================
#
DROP PROCEDURE IF EXISTS p_storm|
Warnings:
Note	1305	PROCEDURE test.p_storm does not exist
CREATE PROCEDURE p_storm(IN base_k INT)
BEGIN
DECLARE CONTINUE HANDLER FOR 1180, 1213, 1205 BEGIN END;
DECLARE CONTINUE HANDLER FOR 1030 SET @err_1030 = @err_1030 + 1;
SET @i = 1;
SET @err_1030 = 0;
WHILE @i <= 200 DO
START TRANSACTION;
UPDATE t1 SET k = @i + base_k WHERE id = 1;
UPDATE t1 SET k = @i + base_k WHERE id = 2;
UPDATE t1 SET k = @i + base_k WHERE id = 3;
COMMIT;
SET @i = @i + 1;
END WHILE;
END|
#
# === Verify: no error 1030 in conflict storm ===
#
# c1 error_1030 count:
SELECT @err_1030 AS err_1030_c1;
err_1030_c1
0
# c2 error_1030 count:
SELECT @err_1030 AS err_1030_c2;
err_1030_c2
0
# c3 error_1030 count:
SELECT @err_1030 AS err_1030_c3;
err_1030_c3
0
# c4 error_1030 count:
SELECT @err_1030 AS err_1030_c4;
err_1030_c4
0
Conflict storm: OK
#
# === Cleanup ===
#
DROP PROCEDURE p_c1;
DROP PROCEDURE p_c2;
DROP PROCEDURE p_c3;
DROP PROCEDURE p_c4;
DROP PROCEDURE p_storm;
DROP TABLE t1;
# Done.
