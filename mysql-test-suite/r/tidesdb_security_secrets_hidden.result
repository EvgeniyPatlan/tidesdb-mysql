# SHOW VARIABLES for the secret-bearing sysvars: expect empty.
SHOW GLOBAL VARIABLES LIKE 'tidesdb_s3_secret_key';
Variable_name	Value
SHOW GLOBAL VARIABLES LIKE 'tidesdb_s3_access_key';
Variable_name	Value
# master_key_file remains visible (path is not a credential; operators
# need to verify config; file permissions on the key file are the
# actual control).
SHOW GLOBAL VARIABLES LIKE 'tidesdb_master_key_file';
Variable_name	Value
tidesdb_master_key_file	
# performance_schema.global_variables: secrets are NOT listed.
SELECT VARIABLE_NAME FROM performance_schema.global_variables
WHERE VARIABLE_NAME IN ('tidesdb_s3_secret_key',
'tidesdb_s3_access_key')
ORDER BY VARIABLE_NAME;
VARIABLE_NAME
# Sanity: an unrelated sysvar is still visible.
SHOW GLOBAL VARIABLES LIKE 'tidesdb_block_cache_size';
Variable_name	Value
tidesdb_block_cache_size	268435456
#
# Done.
