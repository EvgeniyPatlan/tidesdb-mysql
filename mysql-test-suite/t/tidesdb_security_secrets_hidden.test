# Origin: H-5
--source suite/tidesdb/include/have_tidesdb.inc
#
# Regression test for H-5 (S3 secret + access key visible in SHOW VARIABLES).
#
# tidesdb_s3_secret_key and tidesdb_s3_access_key are now declared with
# PLUGIN_VAR_NOSYSVAR so they disappear from SHOW VARIABLES /
# global_variables. They remain settable at startup via my.cnf or
# command-line, but a privileged DBA with only SYSTEM_VARIABLES_ADMIN
# can no longer disclose them through SQL.
#
# tidesdb_master_key_file is intentionally left visible: it's a path,
# not the key itself; operators need it to verify their encryption
# config; tooling queries it. The agent's H-5 finding originally
# flagged it as well, but the security analysis weighs path-disclosure
# differently from credential-disclosure -- file-system permissions
# on the key file are the actual control.
#

--echo # SHOW VARIABLES for the secret-bearing sysvars: expect empty.
SHOW GLOBAL VARIABLES LIKE 'tidesdb_s3_secret_key';
SHOW GLOBAL VARIABLES LIKE 'tidesdb_s3_access_key';

--echo # master_key_file remains visible (path is not a credential; operators
--echo # need to verify config; file permissions on the key file are the
--echo # actual control).
SHOW GLOBAL VARIABLES LIKE 'tidesdb_master_key_file';

--echo # performance_schema.global_variables: secrets are NOT listed.
SELECT VARIABLE_NAME FROM performance_schema.global_variables
 WHERE VARIABLE_NAME IN ('tidesdb_s3_secret_key',
                         'tidesdb_s3_access_key')
 ORDER BY VARIABLE_NAME;

--echo # Sanity: an unrelated sysvar is still visible.
SHOW GLOBAL VARIABLES LIKE 'tidesdb_block_cache_size';

--echo #
--echo # Done.
