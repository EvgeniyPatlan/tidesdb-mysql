--source suite/tidesdb/include/have_tidesdb.inc
#
# Test: SHOW GLOBAL STATUS LIKE 'tidesdb%' status variables
#

--echo #
--echo # TEST 1: Status variables exist
--echo #

# TEST 3 below pins the exact name list; this only catches the whole set
# going missing, which is what a handlerton that failed to register its
# status array looks like.
SELECT COUNT(*) >= 19 AS has_all_vars FROM performance_schema.global_status
WHERE VARIABLE_NAME LIKE 'TIDESDB%';

--echo #
--echo # TEST 2: Variables have reasonable values after table operations
--echo #

CREATE TABLE t_stat (id INT PRIMARY KEY, v VARCHAR(200)) ENGINE=TidesDB;
INSERT INTO t_stat VALUES (1, REPEAT('A', 100)), (2, REPEAT('B', 100));
SELECT * FROM t_stat ORDER BY id;

# Force stats refresh (suppress output -- paths and counters vary per worker)
--disable_result_log
SHOW ENGINE TIDESDB STATUS;
--enable_result_log

# One row, one column per variable, via scalar subqueries. A plain
# WHERE VARIABLE_NAME = ... returns *no rows* for a variable the engine
# stopped publishing, and a recorded empty result asserts nothing -- which
# is how TIDESDB_MEMORY_LIMIT went on "passing" here after TidesDB 10
# removed it. A missing variable now shows as NULL and fails the compare.
SELECT
  (SELECT VARIABLE_VALUE > 0 FROM performance_schema.global_status
     WHERE VARIABLE_NAME = 'TIDESDB_COLUMN_FAMILIES')  AS cf_positive,
  (SELECT VARIABLE_VALUE > 0 FROM performance_schema.global_status
     WHERE VARIABLE_NAME = 'TIDESDB_CACHE_PARTITIONS') AS parts_positive,
  (SELECT VARIABLE_VALUE > 0 FROM performance_schema.global_status
     WHERE VARIABLE_NAME = 'TIDESDB_VERSION_HEX')      AS version_positive;

--echo #
--echo # TEST 3: All variable names are correct
--echo #

SELECT VARIABLE_NAME FROM performance_schema.global_status
WHERE VARIABLE_NAME LIKE 'TIDESDB%' ORDER BY VARIABLE_NAME;

--echo #
--echo # Cleanup
--echo #

DROP TABLE t_stat;

--source suite/tidesdb/include/cleanup_tidesdb.inc
--echo # Done.
