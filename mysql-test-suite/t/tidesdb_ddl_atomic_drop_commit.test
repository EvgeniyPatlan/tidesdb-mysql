--source suite/tidesdb/include/tidesdb_ddl_helpers.inc
#
# A-5 atomic-DDL Task 8: prepare_drop deletes the SDI blob during DROP.
#
# After CREATE TABLE ... ENGINE=TIDESDB the engine writes an SDI blob
# keyed on dd::Table::id() into the __tidesdb_sdi CF (via the SDI
# callbacks landed in Task 5). DROP TABLE then calls
# ha_tidesdb::delete_table() which routes through
# TidesdbAtomicDdlBridge::prepare_drop() BEFORE the CF drop. That bridge
# call removes the SDI blob so the next CREATE TABLE with the same name
# does not collide with stale SDI.
#
# Observable behavior after DROP:
#   1. dd::Table row gone (information_schema.TABLES count == 0).
#   2. A subsequent CREATE TABLE with the same name succeeds (would
#      collide on a stale SDI key if prepare_drop were a no-op and the
#      DD allocated the same Object_id again, but more importantly
#      proves the CF / disk-state cleanup is consistent end-to-end).
#

CREATE TABLE tdb_ddl_t (id INT PRIMARY KEY) ENGINE=TIDESDB;
DROP TABLE tdb_ddl_t;

# After drop: dd::Table row gone, CF gone, SDI blob gone.
SELECT COUNT(*) AS dd_rows FROM information_schema.TABLES
  WHERE TABLE_SCHEMA='test' AND TABLE_NAME='tdb_ddl_t';

# Re-create cycle: confirms no leftover SDI key collides and the disk
# state is clean enough for a fresh CREATE.
CREATE TABLE tdb_ddl_t (id INT PRIMARY KEY, v INT) ENGINE=TIDESDB;
DROP TABLE tdb_ddl_t;

--source suite/tidesdb/include/cleanup_tidesdb.inc
--echo # Done.
