--source suite/tidesdb/include/have_tidesdb.inc
#
# Test: ALTER TABLE ... ADD FULLTEXT INDEX back-populates existing rows
#
# Regression for the inplace-ALTER populate path: adding a FULLTEXT
# index to a table that already has rows must index those rows, not
# just rows written after the index exists. Previously the inplace
# populate scan skipped FTS indexes entirely (`if (is_fts_index(ki))
# continue;`), so MATCH() against a freshly-added FULLTEXT index
# returned zero pre-existing rows.
#

--echo #
--echo # Setup: rows exist BEFORE the FULLTEXT index
--echo #

CREATE TABLE docs (
  id   INT NOT NULL PRIMARY KEY AUTO_INCREMENT,
  body TEXT
) ENGINE=TidesDB;

INSERT INTO docs (body) VALUES
 ('a small reliable widget for everyday use'),
 ('a deluxe gadget with widget compatibility'),
 ('cheap gizmo, no widget mentioned at all'),
 ('completely unrelated text about turtles');

--echo #
--echo # Add FULLTEXT index AFTER rows already exist
--echo #

ALTER TABLE docs ADD FULLTEXT INDEX ft_body (body);

--echo #
--echo # TEST 1: pre-existing rows are found by natural-language MATCH
--echo #

SELECT id FROM docs
WHERE MATCH(body) AGAINST('widget')
ORDER BY id;

--echo #
--echo # TEST 2: boolean mode over back-populated rows
--echo #

SELECT id FROM docs
WHERE MATCH(body) AGAINST('+widget -gizmo' IN BOOLEAN MODE)
ORDER BY id;

--echo #
--echo # TEST 3: no-match query still returns empty
--echo #

SELECT id FROM docs
WHERE MATCH(body) AGAINST('nonexistentkeyword');

--echo #
--echo # TEST 4: writes AFTER the index still index correctly
--echo #         (mixed old + new rows in one result)
--echo #

INSERT INTO docs (body) VALUES ('a brand new widget assembly line');

SELECT id FROM docs
WHERE MATCH(body) AGAINST('widget')
ORDER BY id;

--echo #
--echo # TEST 5: UPDATE of a back-populated row reindexes correctly
--echo #

UPDATE docs SET body = 'turtles all the way down, no hardware here' WHERE id = 1;

SELECT id FROM docs
WHERE MATCH(body) AGAINST('widget')
ORDER BY id;

--echo #
--echo # TEST 6: DELETE of a back-populated row removes it from FTS
--echo #

DELETE FROM docs WHERE id = 2;

SELECT id FROM docs
WHERE MATCH(body) AGAINST('widget')
ORDER BY id;

--echo #
--echo # Cleanup
--echo #

DROP TABLE docs;

--source suite/tidesdb/include/cleanup_tidesdb.inc
--echo # Done.
