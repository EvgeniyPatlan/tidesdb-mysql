--source suite/tidesdb/include/tidesdb_perf_helpers.inc

# Compare INSERT loop wall-clock with capture OFF vs ON. Overhead must
# stay under 25% (5% spec target + 20% MTR noise margin: the connection
# is single-threaded, runs under root in a container, and SYSDATE(6) has
# ~1ms jitter -- so a 2-second loop's repeatability sits around ±300ms).
#
# Use disjoint PK ranges per phase so we never reinsert a row whose
# tombstone might still be visible during a long LSM flush cycle --
# TidesDB's MVCC + WAL fsync window means a delete-then-reinsert of the
# same PK within milliseconds can race against the engine's writer.
# Cheaper for the test: just shift the PK range each phase.

CREATE TABLE t (id INT PRIMARY KEY) ENGINE=TIDESDB;

# Warm-up phase 1: 50 INSERTs with capture OFF. Settles SE caches + the
# server's autocommit pathway.
--disable_query_log
--disable_result_log
let $i = 0;
while ($i < 50) {
  --eval INSERT INTO t VALUES ($i)
  inc $i;
}

# Warm-up phase 2: 50 INSERTs with capture ON. The first INSERT under ON
# triggers the lazy ring_alloc_for_thread() (sizeof(Sample) * 65536 ~=
# 1 MiB malloc). Doing this in warm-up avoids charging that one-time cost
# to the timed ON phase below.
SET GLOBAL tidesdb_perf_capture = ON;
let $i = 1000;
while ($i < 1050) {
  --eval INSERT INTO t VALUES ($i)
  inc $i;
}
SET GLOBAL tidesdb_perf_capture = OFF;
--enable_result_log
--enable_query_log

# Capture OFF baseline. PKs 10000..10999.
SET @t0 = SYSDATE(6);
--disable_query_log
--disable_result_log
let $i = 10000;
while ($i < 11000) {
  --eval INSERT INTO t VALUES ($i)
  inc $i;
}
--enable_result_log
--enable_query_log
SET @off_us = TIMESTAMPDIFF(MICROSECOND, @t0, SYSDATE(6));

# Capture ON. PKs 20000..20999 (disjoint from OFF range).
SET GLOBAL tidesdb_perf_capture = ON;
SET @t0 = SYSDATE(6);
--disable_query_log
--disable_result_log
let $i = 20000;
while ($i < 21000) {
  --eval INSERT INTO t VALUES ($i)
  inc $i;
}
--enable_result_log
--enable_query_log
SET @on_us = TIMESTAMPDIFF(MICROSECOND, @t0, SYSDATE(6));
SET GLOBAL tidesdb_perf_capture = OFF;

# Overhead must be <= 25% (5% target + 20% noise budget). If we regress,
# surface the actual numbers so a flake can be told from a real regression.
SELECT IF(@on_us <= @off_us * 1.25, 'OK',
          CONCAT('REGRESS off_us=', @off_us, ' on_us=', @on_us)) AS verdict;

DROP TABLE t;
SET GLOBAL tidesdb_perf_capture = @save_capture;
