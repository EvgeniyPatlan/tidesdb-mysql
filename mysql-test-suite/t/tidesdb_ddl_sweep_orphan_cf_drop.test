--source suite/tidesdb/include/tidesdb_ddl_helpers.inc
--source include/have_debug.inc
#
# A-5 atomic-DDL Task 11: orphan-CF drop path.
#
# Same shape as the quarantine test, but with tidesdb_orphan_action='drop'
# so apply_delta destroys the CF rather than renaming it. Verifies the
# destructive operator path is wired through the sysvar.
#

SET @save_log_error_verbosity = @@global.log_error_verbosity;
SET GLOBAL log_error_verbosity = 3;
SET GLOBAL tidesdb_orphan_action = 'drop';

SET @@global.DEBUG = '+d,tidesdb_inject_orphan_cf';
--disable_result_log
SHOW ENGINE TIDESDB STATUS;
--enable_result_log
SET @@global.DEBUG = '';

--source include/restart_mysqld.inc

SET GLOBAL log_error_verbosity = 3;
SET GLOBAL tidesdb_orphan_action = 'drop';

--exec : > $MYSQLTEST_VARDIR/log/mysqld.1.err

SET @@global.DEBUG = '+d,tidesdb_run_reconcile';
--disable_result_log
SHOW ENGINE TIDESDB STATUS;
--enable_result_log
SET @@global.DEBUG = '';

let $log_file = $MYSQLTEST_VARDIR/log/mysqld.1.err;
--exec grep -c "dropped orphan CF 'test_orphan_cf_inj'" $log_file

SET GLOBAL log_error_verbosity = @save_log_error_verbosity;
--source suite/tidesdb/include/cleanup_tidesdb.inc
--echo # Done.
