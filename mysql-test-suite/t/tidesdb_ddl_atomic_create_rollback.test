--source suite/tidesdb/include/tidesdb_ddl_helpers.inc
--source include/have_debug.inc
#
# A-5 atomic-DDL Task 6: prepare_create failure aborts CREATE TABLE.
#
# Production engine txn rollback for CREATE TABLE under MySQL 9.7
# requires HTON_SUPPORTS_ATOMIC_DDL on the handlerton (lands in
# Task 13). What Task 6 *does* prove is the local error-propagation
# path: when prepare_create returns false (via the DBUG keyword
# 'tidesdb_fail_after_se_private_data') ha_tidesdb::create returns
# HA_ERR_GENERIC, the server reports an error, and the dd::Table row
# is not persisted.
#
# We do not assert on the exact mysqld errno because the SQL-layer
# wrapper around HA_ERR_GENERIC can surface as either ER_GET_ERRNO
# (1030) or ER_UNKNOWN_ERROR (1105) depending on whether the error
# was raised inside SE-DDL or DD-write. Allow either.
#

SET @@global.DEBUG = '+d,tidesdb_fail_after_se_private_data';
SELECT @@global.DEBUG LIKE '%tidesdb_fail_after_se_private_data%' AS armed;

--error ER_GET_ERRNO,ER_UNKNOWN_ERROR
CREATE TABLE tdb_ddl_t (id INT PRIMARY KEY) ENGINE=TIDESDB;

SET @@global.DEBUG = '';

# The dd::Table row must not exist after the failed CREATE.
SELECT COUNT(*) AS dd_rows
  FROM information_schema.TABLES
  WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 'tdb_ddl_t';

--source suite/tidesdb/include/cleanup_tidesdb.inc
--echo # Done.
