--source suite/tidesdb/include/have_tidesdb.inc
#
# Regression test for H-10 (ICP advertised but check stub returned 0).
#
# The plugin advertises HA_DO_INDEX_COND_PUSHDOWN and idx_cond_push()
# sets in_range_check_pushed_down=true, telling MySQL the engine will
# honor end_range AND filter the pushed condition. Pre-fix, the
# MariaDB-port handler_index_cond_check stub returned 0 unconditionally,
# so neither the condition nor end_range was checked. End-range rows
# could leak through on secondary-index range scans.
#
# Fix: pushed_idx_cond->val_bool() and compare_key_icp(end_range) are
# now evaluated inline in icp_check_secondary.
#

CREATE TABLE t_icp (
  id INT NOT NULL PRIMARY KEY,
  k  INT NOT NULL,
  v  VARCHAR(20),
  KEY idx_k (k)
) ENGINE=TidesDB;

INSERT INTO t_icp VALUES
  (1,  10, 'a'),
  (2,  20, 'b'),
  (3,  30, 'c'),
  (4,  40, 'd'),
  (5,  50, 'e'),
  (6,  60, 'f'),
  (7,  70, 'g'),
  (8,  80, 'h'),
  (9,  90, 'i'),
  (10,100, 'j');

--echo # Secondary-index range scan. end_range = 50, MUST NOT include rows
--echo # past it. Pre-fix this could leak rows 6-10 because the stub didn't
--echo # check end_range when in_range_check_pushed_down=true.
SELECT id, k FROM t_icp WHERE k BETWEEN 20 AND 50 ORDER BY id;

--echo # Range scan combined with a pushed condition that filters most rows.
--echo # Result must be the intersection: k in [20..80] AND v in ('b','d','f','h').
SELECT id, k, v FROM t_icp
WHERE k BETWEEN 20 AND 80
  AND v IN ('b','d','f','h')
ORDER BY id;

--echo # Open-ended range (k >= 70). end_range here is unbounded so
--echo # filtering is purely by pushed condition.
SELECT id, k FROM t_icp WHERE k >= 70 ORDER BY id;

DROP TABLE t_icp;

--echo #
--echo # Done.
